pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Environment') {
            steps {
                sh '''
                    export PATH="/opt/homebrew/bin:$PATH"
                    java --version
                    mvn --version
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                    export PATH="/opt/homebrew/bin:$PATH"
                    mvn clean test -Dtestsuitefile=testNG.xml
                '''
            }
        }
    }

    post {
        always {
            echo 'Test execution completed'
        }
    }
}